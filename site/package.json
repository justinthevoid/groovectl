{
	"name": "groovectl-site",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.3.10",
	"scripts": {
		"dev": "node scripts/sync-docs.mjs && astro dev",
		"check": "node scripts/sync-docs.mjs && astro check",
		"build": "node scripts/sync-docs.mjs && node scripts/licenses.mjs && astro build && node scripts/check-output.mjs",
		"preview": "astro preview",
		"deploy:check": "wrangler deploy --dry-run",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@astrojs/starlight": "0.42.6",
		"@astrojs/svelte": "9.0.1",
		"@astrojs/markdown-remark": "7.3.2",
		"@fontsource-variable/fraunces": "5.3.0",
		"@fontsource-variable/dm-sans": "5.3.0",
		"astro": "7.3.8",
		"gsap": "3.15.0",
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"typescript": "7.0.2",
		"wrangler": "4.151.0"
	}
}
