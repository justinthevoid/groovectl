  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Raspberry setup or copy action on a paper surface.",
      "html": "<button class=\"ds-primary\" type=\"button\">Set up Groovectl</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:.8rem;min-height:48px;padding:.75rem 1.15rem;border-radius:12px;border:1px solid transparent;font-family:var(--font-body,\"DM Sans Variable\",sans-serif);font-size:.95rem;font-weight:650;line-height:1.4;text-decoration:none;cursor:pointer;transition:background .18s,color .18s;background:var(--berry,#a82646);color:var(--paper,#faf7ef);}.ds-primary:hover{background:var(--berry-dark,#841d36);color:var(--paper,#faf7ef);}.ds-primary:focus-visible{outline:3px solid var(--berry,#a82646);outline-offset:4px;}.ds-primary:disabled{cursor:not-allowed;opacity:.5;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none!important;animation:none!important;}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined action on the landing page paper.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Find your starting point</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.8rem;min-height:48px;padding:.75rem 1.15rem;border-radius:12px;border:1px solid transparent;font-family:var(--font-body,\"DM Sans Variable\",sans-serif);font-size:.95rem;font-weight:650;line-height:1.4;text-decoration:none;cursor:pointer;transition:background .18s,color .18s;background:transparent;border-color:var(--line,#d4d0c2);color:var(--ink,#29291f);}.ds-secondary:hover{background:var(--wash,#f0ecdf);}.ds-secondary:focus-visible{outline:3px solid var(--berry,#a82646);outline-offset:4px;}.ds-secondary:disabled{cursor:not-allowed;opacity:.5;}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none!important;animation:none!important;}}"
    },
    {
      "name": "Studio secondary button",
      "kind": "button",
      "refersTo": "button-studio-secondary",
      "description": "The existing surprise action, shown on its olive working surface.",
      "html": "<div class=\"ds-studio-context\"><button class=\"ds-studio-secondary\" type=\"button\">Surprise me <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m4 7 4-3 4 3 4-3 4 3v10l-4 3-4-3-4 3-4-3zM8 4v13m4-10v10m4-13v13\"/></svg></button></div>",
      "css": ".ds-studio-context{background:var(--olive,#41472e);padding:1rem;}.ds-studio-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.8rem;min-height:48px;padding:.75rem 1.15rem;border-radius:12px;border:1px solid transparent;font-family:var(--font-body,\"DM Sans Variable\",sans-serif);font-size:.95rem;font-weight:650;line-height:1.4;text-decoration:none;cursor:pointer;transition:background .18s,color .18s;background:transparent;border-color:#a6ac8d;color:#fff8e9;}.ds-studio-secondary:hover{background:#59603e;}.ds-studio-secondary:focus-visible{outline:3px solid #e7b3a8;outline-offset:4px;}.ds-studio-secondary:disabled{cursor:not-allowed;opacity:.5;}.ds-studio-secondary svg{width:1.15rem;height:1.15rem;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}@media(prefers-reduced-motion:reduce){.ds-studio-secondary{transition:none!important;animation:none!important;}}"
    },
    {
      "name": "Native answer select",
      "kind": "input",
      "refersTo": "select",
      "description": "An existing question and native select on olive.",
      "html": "<div class=\"ds-select-context\"><label class=\"ds-select-label\" for=\"ds-scene\">Where are we listening?</label><select class=\"ds-select\" id=\"ds-scene\"><option>The long way home</option><option>Dinner with the windows open</option><option>A quiet Sunday morning</option></select></div>",
      "css": ".ds-select-context{background:var(--olive,#41472e);padding:1rem;color:#fbf7e9;font-family:var(--font-body,\"DM Sans Variable\",sans-serif);line-height:1.6;}.ds-select-label{display:block;margin-bottom:.5rem;font-size:1rem;font-weight:620;}.ds-select{width:100%;min-width:0;padding:.75rem 2rem .75rem .8rem;background:#f7f4e9;color:var(--ink,#29291f);border:1px solid transparent;border-radius:10px;font-family:inherit;font-size:.93rem;line-height:inherit;cursor:pointer;}.ds-select:focus-visible{outline:3px solid #e7b3a8;outline-offset:4px;}@media(max-width:760px){.ds-select{font-size:1rem;}}"
    },
    {
      "name": "Exclusions field",
      "kind": "input",
      "refersTo": "exclusions-field",
      "description": "A vertically resizable text field on the studio surface.",
      "html": "<div class=\"ds-field-context\"><label class=\"ds-field-label\" for=\"ds-exclusions\">Anything to keep out?</label><textarea class=\"ds-exclusions\" id=\"ds-exclusions\" rows=\"2\">No live versions. Avoid consecutive songs by the same artist.</textarea></div>",
      "css": ".ds-field-context{background:var(--olive,#41472e);padding:1rem;color:#fbf7e9;font-family:var(--font-body,\"DM Sans Variable\",sans-serif);line-height:1.6;}.ds-field-label{display:block;margin-bottom:.5rem;font-size:1rem;font-weight:620;}.ds-exclusions{width:100%;border:1px solid #8a9075;border-radius:10px;color:#fff8e9;background:transparent;padding:.7rem .8rem;resize:vertical;font-family:inherit;font-size:.95rem;line-height:inherit;caret-color:var(--berry,#a82646);}.ds-exclusions:focus-visible{outline:3px solid #e7b3a8;outline-offset:4px;}"
    },
    {
      "name": "Reroll button",
      "kind": "button",
      "refersTo": "button-reroll",
      "description": "The adjacent icon action for an unlocked question.",
      "html": "<div class=\"ds-reroll-context\"><button class=\"ds-reroll\" type=\"button\" aria-label=\"Reroll where are we listening?\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 8a8 8 0 0 0-14-2L3 9m0-6v6h6M4 16a8 8 0 0 0 14 2l3-3m0 6v-6h-6\"/></svg></button></div>",
      "css": ".ds-reroll-context{background:var(--olive,#41472e);padding:1rem;}.ds-reroll{width:48px;min-height:48px;border:1px solid #8a9075;border-radius:10px;background:transparent;color:#fff8e9;display:grid;place-items:center;cursor:pointer;}.ds-reroll:hover{background:#59603e;}.ds-reroll:focus-visible{outline:3px solid #e7b3a8;outline-offset:4px;}.ds-reroll:disabled{cursor:not-allowed;opacity:.5;}.ds-reroll svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}"
