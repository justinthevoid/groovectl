      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-nav-demo\" href=\"#brief\">Try a brief</a><a href=\"/docs/overview/\">Docs</a><a href=\"/docs/install/\">Get started</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:1.6rem;font-family:var(--font-body,\"DM Sans Variable\",sans-serif);font-size:.95rem;line-height:1.6;color:var(--ink,#29291f);}.ds-nav a{color:inherit;text-decoration:none;text-underline-offset:.22em;}.ds-nav a:last-child{text-decoration:underline;text-decoration-color:var(--berry,#a82646);text-decoration-thickness:2px;}.ds-nav a:hover{color:var(--berry,#a82646);}.ds-nav a:focus-visible{outline:3px solid var(--berry,#a82646);outline-offset:4px;}@media(max-width:760px){.ds-nav{gap:1rem;font-size:.85rem;}.ds-nav-demo{display:none;}}"
    },
    {
