{
	"name": "groovectl",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/justinthevoid/groovectl.git"
	},
	"homepage": "https://github.com/justinthevoid/groovectl#readme",
	"bugs": {
		"url": "https://github.com/justinthevoid/groovectl/issues"
	},
	"version": "0.6.0-rc.5",
	"description": "Apple Music for agents: thoughtful playlists, library exploration, and native or Cider playback.",
	"type": "module",
	"license": "MIT",
	"author": "Justin Hogan",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.3.10",
	"bin": {
		"groovectl": "dist/cli.js",
		"apple-music-hybrid": "dist/cli.js"
	},
	"files": [
		"dist/cli.js",
		"dist/workspace.html",
		"native/Package.swift",
		"native/Sources",
		"native/Tests",
		"native/windows-media.ps1",
		"native/entitlements.plist",
		".native-resource.json",
		"scripts/build-helper.mjs",
		"scripts/install-helper.mjs",
		"scripts/package-helper.mjs",
		"scripts/native",
		"README.md",
		"CHANGELOG.md",
		"docs",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md",
		"UI_THIRD_PARTY_LICENSES.txt",
		"SERVER_THIRD_PARTY_LICENSES.txt",
		"licenses",
		"assets/brand/mark.svg",
		"assets/brand/vinyl-journey.webp",
		"assets/brand/vinyl-journey.webp.json",
		"assets/brand/vinyl-journey.prompt.txt",
		"assets/brand/PROVENANCE.md",
		"assets/examples/between-stations.png",
		"assets/examples/between-stations.prompt.txt",
		"assets/examples/PROVENANCE.md",
		"site/README.md",
		"deploy",
		"CONTRIBUTING.md",
		"SECURITY.md",
		"PRIVACY.md",
		"SUPPORT.md",
		"CODE_OF_CONDUCT.md",
		"AGENTS.md"
	],
	"scripts": {
		"build": "tsc && node scripts/build.mjs",
		"check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.ui.json --fail-on-warnings",
		"test": "node --import tsx --test tests/*.test.ts",
		"test:legacy": "uv run --project server --group dev --frozen pytest server/tests -q",
		"build:helper": "node scripts/build-helper.mjs",
		"prepack": "bun run build",
		"start": "node dist/cli.js serve",
		"package:plugin": "node scripts/package-plugin.mjs",
		"preflight": "node scripts/release-preflight.mjs",
		"build:gallery": "node scripts/build-gallery.mjs"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "2.3.1",
		"@modelcontextprotocol/ext-apps": "1.7.5",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@modelcontextprotocol/server": "2.3.1",
		"@openai/mcp-extensions": "0.2.0",
		"@types/node": "26.6.5",
		"esbuild": "0.28.2",
		"fflate": "0.8.3",
		"jose": "6.2.12",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"zod": "4.6.7",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"@lucide/svelte": "1.57.0"
	}
}
